GEMMA_MODEL_VERSION=ai/gemma3
GEMMA_BASE_URL=http://localhost:12434/engines

DB_H2_URL_CONFIG=jdbc:h2:file:./data/h2-chat-memory;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE
DB_H2_HIRAKI_URL_CONFIG=jdbc:h2:file:./data/h2-chat-memory
DB_H2_USERNAME=sa
DB_H2_PASSWORD=

CLASSPATH_DB_SCHEMA=classpath:db/chat-memory-schema.sql
CLASSPATH_DB_SCHEMA_RAG=classpath:db/schema-rag.sql

LOGGING_PATTERN_CONSOLE="%green(%d{HH:mm:ss.SSS}) %blue(%-5level) %red([%thread]) %yellow(%logger{15}) - %msg%n"

#http://localhost:6333/dashboard
QDRANT_HOST=localhost
QDRANT_PORT=6334
COLLECTION_NAME=documentos

#DATA LOADER
DATA_LOADER_FILE_ENABLED=true

#RH
RH_LOADER_FILE_ENABLED=true

#AI
AI_LOADER_FILE_ENABLED=true

