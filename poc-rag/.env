OPENAI_API_KEY=coloque aqui sua API_KEY
OPENIA_MODEL_VERSION=gpt-4o-mini
#          "llama3.2:1b"  #1.3GB
#          model: "llama3.3:70b" 45GB
#          model: "olmo-3:7b" 4.5GB
#          temperature: 0.7
